---
const {
  title = "¿Desea más información?",
  phone = "+506 24375750",
  whatsapp = "+506 70717800",
  email = "sales@angular-tech.com",
  buttonText = "Evaluación gratuita"
} = Astro.props;
---

<section class="cta">
  <div class="cta__box">
    <h2>{title}</h2>

    <div class="cta__content">
      <span class="cta__line"></span>

      <div>
        <p><strong>Contáctenos.</strong></p>
        <p>Tel. Oficina: {phone}</p>
        <p>Whatsapp: {whatsapp}</p>
        <p>Correo: {email}</p>
      </div>
    </div>

    <button class="cta__btn">
      <span>+</span>
      {buttonText}
    </button>
  </div>
</section>

<style>
  .cta {
    background: #f2f2f2;
    padding: 4rem 1rem;
    display: flex;
    justify-content: center;
  }

  .cta__box {
    background: #ddd;
    padding: 3rem;
    max-width: 700px;
    width: 100%;
    position: relative;
    padding-bottom: 5rem;
  }

  h2 {
    text-align: center;
    color: #1f3b73;
    margin-bottom: 2rem;
  }

  .cta__content {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .cta__line {
    width: 50px;
    height: 2px;
    background: #1f3b73;
    margin-top: 10px;
  }

  .cta__btn {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    border: none;
    cursor: pointer;
    background: red;
    color: white;
    padding: 0.8rem 1.2rem;
  }

  .cta__btn span {
    background: #1f3b73;
    color: white;
    padding: 0.8rem 1rem;
    margin-right: 0.5rem;
  }

  @media (max-width: 600px) {
    .cta__content {
      flex-direction: column;
    }

    .cta__btn {
      position: static;
      margin-top: 2rem;
      width: 100%;
      justify-content: center;
    }
  }
</style>