---
const items = [
  {
    year: "Año 2021",
    text: "Angular inicia operaciones como proveedor tecnológico para las 25 empresas que integran Grupo Tical Holding, con un enfoque especializado en el ámbito logístico."
  },
  {
    year: "Año 2022",
    text: "Ejecutamos con éxito el proyecto de implementación “Oracle Transportation Management” para Transportes Internacionales Tical, con el objetivo de automatizar y optimizar los procesos logísticos relacionados con la gestión del transporte. Este proyecto, ejecutado en el transcurso de un año, se desplegó exitosamente en Panamá, Costa Rica, Nicaragua, El Salvador, Guatemala, Honduras y México."
  },
  {
    year: "Años 2023 y 2024",
    text: "Llevamos a cabo la implementación de Oracle CX y Oracle ERP para todas las empresas del Grupo, abarcando el rediseño del proceso Order to Cash y la gestión integrada de los servicios de transporte, agenciamiento aduanal, agenciamiento de carga internacional, almacenamiento, distribución y, en general, de todos los procesos comerciales y financieros del Grupo. El go live, realizado en enero de 2025, fue altamente exitoso."
  },
  {
    year: "Año 2025",
    text: "Angular se enfocó en estabilizar las herramientas de la suite de Oracle, brindando soporte a las distintas áreas y empresas del Grupo. Ese mismo año, se emprendió el rediseño del proyecto de Factura Electrónica versión 4.4 para Costa Rica, alcanzando un 99.99% de acierto en la generación electrónica de facturas. Simultáneamente, Angular apoyó en proyectos OWMS e integraciones con clientes como Reckitt Benckiser, Clínica Bíblica y Mondelēz."
  },
  {
    year: "Año 2026",
    text: "Proyectamos un crecimiento sostenido en la ejecución de grandes proyectos para nuestros clientes."
  }
];
---

<section class="history">
  <h2>Nuestra Historia.</h2>

  <div class="slider">
    <button class="nav prev">←</button>

    <div class="track">
      <div class="track-inner">
        {items.map((item) => (
          <div class="slide">
            <h3>{item.year}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <button class="nav next">→</button>
  </div>

  <div class="dots">
    {Array.from({ length: Math.ceil(items.length / 3) }).map((_, i) => (
      <span class="dot" data-index={i}></span>
    ))}
  </div>
</section>

<style>
.history {
  text-align: center;
  padding: 4rem 1rem;
  color: #0a2a66;
}

h2 {
  margin-bottom: 2rem;
  font-weight: 500;
}

/* SLIDER */
.slider {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  max-width: 900px;
  margin: 0 auto;
}

.track {
  overflow: hidden;
  width: 100%;
}

.track-inner {
  display: flex;
  gap: 1rem;
  transition: transform 0.5s ease;
  margin-left: 10px;
}

/* CARD */
.slide {
  flex: 0 0 calc((100% / 3) - 0.666rem);
  box-sizing: border-box;
  padding: 1.5rem;
  background: #f5f7fa;
  border: 1px solid #ddd;
  box-shadow: 0 10px 20px rgba(0,0,0,0.08);

  text-align: left;
  border-left: 3px solid #0a2a66;
}

.slide h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
  letter-spacing: 0.5px;
}

.slide p {
  font-size: 0.9rem;
  line-height: 1.6;
  color: #333;
  margin: 0;
  max-width: 420px;
}

/* NAV */
.nav {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: #0a2a66;
}

/* DOTS */
.dots {
  margin-top: 1rem;
}

.dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  background: #0a2a66;
  border-radius: 50%;
  margin: 0 4px;
  opacity: 0.4;
  cursor: pointer;
}

.dot.active {
  opacity: 1;
  
}

@media (max-width: 768px) {
  .slide {
    flex: 0 0 100%;
  }
  
  .track-inner{
    gap: 0px;
  }

}

</style>

<script>
  const trackInner = document.querySelector('.track-inner');
  const slides = document.querySelectorAll('.slide');
  const prev = document.querySelector('.prev');
  const next = document.querySelector('.next');
  const dotsContainer = document.querySelector('.dots');

  let index = 0;

  function getSlidesPerPage() {
    return window.innerWidth <= 768 ? 1 : 3;
  }

  function updateSlider() {
    const slidesPerPage = getSlidesPerPage();
    const totalPages = Math.ceil(slides.length / slidesPerPage);

    // Evitar que el índice quede fuera de rango al redimensionar
    if (index >= totalPages) index = totalPages - 1;

    // Desplazamiento simple basado en porcentaje
    const offset = index * 100;
    trackInner.style.transform = `translateX(-${offset}%)`;

    // Renderizar o actualizar dots dinámicamente
    renderDots(totalPages);
  }

  function renderDots(totalPages) {
    dotsContainer.innerHTML = ''; // Limpiar
    for (let i = 0; i < totalPages; i++) {
      const dot = document.createElement('span');
      dot.classList.add('dot');
      if (i === index) dot.classList.add('active');
      dot.addEventListener('click', () => {
        index = i;
        updateSlider();
      });
      dotsContainer.appendChild(dot);
    }
  }

  prev.addEventListener('click', () => {
    const totalPages = Math.ceil(slides.length / getSlidesPerPage());
    index = (index - 1 + totalPages) % totalPages;
    updateSlider();
  });

  next.addEventListener('click', () => {
    const totalPages = Math.ceil(slides.length / getSlidesPerPage());
    index = (index + 1) % totalPages;
    updateSlider();
  });

  window.addEventListener('resize', updateSlider);

  // Inicializar
  updateSlider();
</script>
</script>