<section class="contact">
  <div class="form-card">
    <h2>Queremos ayudarle</h2>

    <form class="form" id="contactForm">
      <div class="row">
        <div class="input-group">
          <input type="text" name="nombre" required />
          <label>Nombre *</label>
        </div>

        <div class="input-group">
          <input type="text" name="apellido" required />
          <label>Apellido *</label>
        </div>
      </div>

      <div class="input-group">
        <input type="email" name="email" required />
        <label>Email *</label>
      </div>

      <div class="input-group">
        <input type="text" name="asunto"/>
        <label>Asunto</label>
      </div>

      <div class="input-group">
        <input type="text" name="telefono"/>
        <label>Teléfono</label>
      </div>

      <div class="input-group">
        <input type="text" name="direccion" />
        <label>Dirección</label>
      </div>

      <div class="input-group">
        <textarea name="mensaje" required></textarea>
        <label>Mensaje</label>
      </div>

      <button type="submit" id="submitBtn">Enviar</button>
      <p id="responseMessage" style="color: white; text-align: center; margin-top: 1rem; display: none;"></p>
    </form>
  </div>
</section>

<script>
  // Usamos una función para encapsular y asegurar que los elementos existan
  const setupForm = () => {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const btn = document.getElementById('submitBtn') as HTMLButtonElement;
    const responseMsg = document.getElementById('responseMessage');

    // Si el formulario no existe en esta página, salimos sin hacer nada
    if (!form || !btn || !responseMsg) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      btn.disabled = true;
      btn.innerText = "Enviando...";

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('https://devapp.grupotical.com/ats/form.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        // Verificamos si la respuesta es un JSON válido
        const result = await response.json().catch(() => ({ ok: false }));

        if (result.ok) {
          responseMsg.innerText = "¡Mensaje enviado correctamente!";
          responseMsg.style.display = "block";
          responseMsg.style.color = "white";
          form.reset();
        } else {
          throw new Error("Error en servidor");
        }
      } catch (error) {
        console.error("Detalles del error:", error);
        responseMsg.innerText = "Hubo un error al enviar. Intente de nuevo.";
        responseMsg.style.display = "block";
        responseMsg.style.color = "#ff4d4d";
      } finally {
        btn.disabled = false;
        btn.innerText = "Enviar";
      }
    });
  };

  // Ejecutar la función
  setupForm();
</script>

<style>

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #1e2f5c;
}
    
.contact {
  background: #1e2f5c;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 3rem 1rem;
}

.form-card {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(10px);
  width: 100%;
  max-width: 42rem;
  border-radius: 12px;
  padding: 2rem;
  animation: fadeUp 0.8s ease;
}

.form-card h2 {
  text-align: center;
  color: white;
  margin-bottom: 2rem;
  font-size: 2.5rem;
}

/* GRID */
.row {
  display: flex;
  gap: 1.5rem;
  width: 100%;
}

.input-group {
  position: relative;
  margin-bottom: 1.5rem;
  width: 100%;
}

.input-group input,
.input-group textarea {
  width: 100%;
  padding: 12px;
  background: transparent;
  border: 1px solid #aaa;
  color: white;
  outline: none;
  font-size: 1rem;
}

.input-group textarea {
  min-height: 100px;
  resize: vertical;
}

/* LABEL flotante */
.input-group label {
  position: absolute;
  top: 12px;
  left: 12px;
  color: #ccc;
  transition: 0.3s;
  pointer-events: none;
}

/* Animación */
.input-group input:focus + label,
.input-group input:valid + label,
.input-group textarea:focus + label,
.input-group textarea:valid + label {
  top: -10px;
  left: 10px;
  font-size: 0.8rem;
  color: #ff4d4d;
  background: #243874;
  padding: 0 5px;
}

/* Focus glow */
.input-group input:focus,
.input-group textarea:focus {
  border-color: #ff4d4d;
  box-shadow: 0 0 8px rgba(255, 0, 0, 0.4);
}

/* BOTÓN */
button {
  width: 100%;
  padding: 12px;
  background: red;
  color: white;
  border: none;
  cursor: pointer;
  font-size: 1.2rem;
  border-radius: 6px;
  transition: 0.3s;
}

button:hover {
  background: #cc0000;
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(255,0,0,0.4);
}

/* ANIMACIÓN */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 900px) {
  .row {
    flex-direction: column;
    gap: 0;
  }
  .form-card {
    padding: 1.5rem;
  }
  .form-card h2{
    font-size: 1.6rem;
  }
}

</style>