<header class="header">
  <div class="container">
    
    <!-- Logo -->
    <div class="logo">
      <img src="images/Logo.png" alt="ATS Logo" />
    </div>

    <!-- Navegación -->
    <nav class="nav">
      <a href="/#hero">Inicio</a>
      <a href="/about">Sobre Nosotros</a>
      <a href="/#services">Servicios</a>
      <a href="#sectores">Sectores</a>
      <a href="/#information">Contacto</a>
    </nav>

    <!-- Idioma -->
    <div class="lang">
      <select>
        <option>Español</option>
        <option>English</option>
      </select>
    </div>

  </div>
</header>

<style>
.header {
  position: sticky;
  top: 0;
  z-index: 10000;
  background: white;
}

.container {
  margin: 0 auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  padding: 15px 20px;
}

.logo img {
  width: 300px;
  margin-right: -10px
}

.nav {
  display: flex;
  justify-content: center;
  gap: 40px;
}

.nav a {
  text-decoration: none;
  color: #0a2540;
  font-weight: 500;
  font-size: 1.2rem;
}

.lang {
  display: flex;
  justify-content: flex-end;
}

.lang select {
  padding: 5px 10px;
}

.nav a:hover {
  color: red;
}

nav a.active {
  color: red;
  font-weight: bold;
}

@media (max-width: 900px) {
  .container {
    grid-template-columns: 1fr;
    gap: 10px;
    text-align: center;
    height: fit-content;
  }

  .nav {
    flex-wrap: wrap;
    gap: 15px;
  }

  .lang {
    justify-content: center;
  }

  .logo {
    display: flex;
    justify-content: center;
  }

  .logo img {
    width: 180px;
    margin-right: 20px
  }
  .header {
    height: fit-content;
  }
}
</style>

<script>
  const sections = document.querySelectorAll("section");
  const navLinks = document.querySelectorAll("nav a");

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(link => {
          link.classList.remove("active");
          if (link.getAttribute("href") === "#" + entry.target.id) {
            link.classList.add("active");
          }
        });
      }
    });
  }, { threshold: 0.6 });

  sections.forEach(section => observer.observe(section));
</script>