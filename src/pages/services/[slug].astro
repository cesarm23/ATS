---
import { services } from "../../data/services";
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const slugs = [
    "desarrollo-sistemas",
    "soporte-infraestructura",
    "redes-empresariales",
    "ciberseguridad",
    "gestion-proyectos"
  ];

  return slugs.map((slug) => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;
const service = services[slug as keyof typeof services];

---

<Layout>
	<Header />

	<main>
		<section class="service-detail">
      <div class="block-blue"></div>
      <div class="header-box">
        <h1>
          {service ? service.title : "Servicio en mantenimiento"}
        </h1>
      </div>

      {service ? (
        <div class="content" set:html={service.content}></div>
      ) : (
        <div class="coming-soon">
          <div class="icon">🚧</div>
          <h2>Estamos trabajando en este servicio</h2>
          <p>
            Pronto tendrás más información disponible. Estamos preparando
            contenido de calidad para ti.
          </p>
          <div class="loader"></div>
        </div>
      )}

      <a href="/#services" class="back">Volver</a>
    </section>

	</main>

	<Footer />
</Layout>

<style>
.block-blue {
  background: #243874;
  width: 100%;
  height: 10rem;
  margin-bottom: -5rem;
}  
.service-detail {
  background: #eaeaea;
}
.header-box {
  background: #fff;
  width: 40rem;
  margin: 0 auto 2rem;
  padding: 1.5rem 3rem;
  text-align: center;
  box-shadow: 10px 10px 0 #ddd;
}

.header-box h1 {
  color: #243874;
  font-size: 3rem;
}

.content {
  max-width: 700px;
  margin: 0 auto;
  color: #1e3a5f;
  line-height: 1.6;
}

.back {
  display: flex;
  margin: auto;
  align-items: center;
  width: fit-content;
  background: #0a2540;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  cursor: pointer;
  font-size: 1.5rem;
}

.coming-soon {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
  padding: 2rem;
  animation: fadeUp 0.8s ease;
}

.coming-soon .icon {
  font-size: 3rem;
  margin-bottom: 1rem;
  animation: float 2.5s ease-in-out infinite;
}

.coming-soon h2 {
  color: #243874;
  margin-bottom: 1rem;
}

.coming-soon p {
  color: #1e3a5f;
  line-height: 1.6;
}

.loader {
  margin: 2rem auto 0;
  width: 40px;
  height: 40px;
  border: 4px solid #ddd;
  border-top: 4px solid #243874;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}


@media (max-width: 900px) {
  .header-box {
    width: fit-content;
    padding: 1rem 0rem;
  }
  
}
</style>