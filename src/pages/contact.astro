---
import Form from "../components/Form.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout>
  <main class="contact-page">
    <button class="back-button" onclick="window.history.back()">Volver</button>
    <img src="/images/Logo.png" class="logo" />

    <Form />
  </main>
</Layout>


<style>
button {
  background: #0a2540;
  color: white;
  border: none;
  padding: 10px 20px;
  border-radius: 5px;
  cursor: pointer;
  margin: 30px;
  font-size: 1.5rem;
}

img {
  display: block;
  margin: 0 auto;
  padding: 1rem;
  border-radius: 20px;
  width: 400px;
}

@media (max-width: 900px) {
  img {
    width: 200px;
  }
}

</style>